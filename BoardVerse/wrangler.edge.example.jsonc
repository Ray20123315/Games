{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "games-edge",
  "main": "src/edge-proxy.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": false,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "xn--gmqt6w03b11v.ray2025.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "BOARDVERSE_ORIGIN_URL": "https://boardverse-origin.REPLACE_WITH_NEW_ACCOUNT_SUBDOMAIN.workers.dev"
  }
}
