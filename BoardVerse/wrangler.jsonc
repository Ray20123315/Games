{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crimson-haze-0a4d",
  "main": "src/index-v011.js",
  "compatibility_date": "2026-08-28",
  "routes": [
    {
      "pattern": "xn--gmqt6w03b11v.ray2025.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "GLOBAL_CHAT", "class_name": "GlobalChat" }
    ]
  },
  "exports": {
    "GameRoom": { "type": "durable-object", "storage": "sqlite" },
    "GlobalChat": { "type": "durable-object", "storage": "sqlite" }
  },
  "triggers": {
    "crons": ["0 16 * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEgJg9Xf_BRP8k0b",
    "TURNSTILE_HOSTNAMES": "xn--gmqt6w03b11v.ray2025.com,多人棋室.ray2025.com"
  }

  // BOARDVERSE_DB intentionally is not declared here until the real Cloudflare
  // D1 resource exists. Cloudflare requires binding + database_name + database_id.
  // Required production binding: BOARDVERSE_DB -> D1 database "boardverse".
  // Workers Builds is validated through the repository-root CI adapter.
  // Do not replace the D1 UUID with a fabricated value.
}
