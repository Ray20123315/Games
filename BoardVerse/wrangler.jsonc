{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "games",
  "main": "src/index-v011.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": false,
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoomV011" },
      { "name": "GLOBAL_CHAT", "class_name": "GlobalChatV011" },
      { "name": "BOARDVERSE_DB_DO", "class_name": "BoardVerseDbV011" }
    ]
  },
  "exports": {
    "GameRoom": { "type": "durable-object", "storage": "sqlite" },
    "GlobalChat": { "type": "durable-object", "storage": "sqlite" },
    "BoardVerseDb": { "type": "durable-object", "storage": "sqlite" },
    "GameRoomV011": { "type": "durable-object", "storage": "sqlite" },
    "GlobalChatV011": { "type": "durable-object", "storage": "sqlite" },
    "BoardVerseDbV011": { "type": "durable-object", "storage": "sqlite" }
  },
  "triggers": { "crons": ["0 16 * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEgJg9Xf_BRP8k0b",
    "TURNSTILE_HOSTNAMES": "xn--gmqt6w03b11v.ray2025.com,多人棋室.ray2025.com"
  }
}
