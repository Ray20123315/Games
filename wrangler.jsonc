{
  "name": "crimson-haze-0a4d",
  "main": "BoardVerse/src/index-v011.js",
  "compatibility_date": "2026-08-28",
  "routes": [
    {
      "pattern": "xn--gmqt6w03b11v.ray2025.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
