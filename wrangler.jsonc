    "TURNSTILE_HOSTNAMES": "xn--gmqt6w03b11v.ray2025.com,多人棋室.ray2025.com"
  }

  // Production shape for BoardVerse. Workers Builds currently invokes a fixed
  // root-level `npx wrangler ...` command, so the repository-local CI adapter
