#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';
import { spawnSync } from 'node:child_process';

const REAL_WRANGLER = 'wrangler@4.127.1';
const PROD_WORKER = 'crimson-haze-0a4d';
const D1_NAME = 'boardverse';
const D1_BINDING = 'BOARDVERSE_DB';
const branch = process.env.WORKERS_CI_BRANCH || '';
const isWorkersCI = process.env.WORKERS_CI === '1';
const self = fs.realpathSync(process.argv[1]);
const parked = `${self}.boardverse-ci-disabled`;

function runWrangler(args, { capture = false, allowFailure = false } = {}) {
  fs.renameSync(self, parked);
  try {
    const result = spawnSync('npx', ['--yes', REAL_WRANGLER, ...args], {
      cwd: process.cwd(),
      env: process.env,
      encoding: 'utf8',
      stdio: capture ? ['ignore', 'pipe', 'pipe'] : 'inherit',
    });
    if (result.error) throw result.error;
    if (result.status !== 0 && !allowFailure) {
      if (capture) {
        if (result.stdout) process.stdout.write(result.stdout);
        if (result.stderr) process.stderr.write(result.stderr);
      }
      throw new Error(`wrangler ${args.join(' ')} failed with exit ${result.status}`);
    }
    return result;
  } finally {
    if (fs.existsSync(parked)) fs.renameSync(parked, self);
  }
}

function parseJsonOutput(text) {
  const s = String(text || '').trim();
  const starts = [s.indexOf('['), s.indexOf('{')].filter((x) => x >= 0).sort((a,b) => a-b);
  for (const start of starts) {
    try { return JSON.parse(s.slice(start)); } catch {}
  }
  throw new Error('Unable to parse Wrangler JSON output');
}

function findVersionIds(value, out = new Set()) {
  if (Array.isArray(value)) for (const x of value) findVersionIds(x, out);
  else if (value && typeof value === 'object') {
    for (const [k,v] of Object.entries(value)) {
      if ((k === 'id' || k === 'version_id' || k === 'versionId') && typeof v === 'string' && /^[0-9a-f-]{36}$/i.test(v)) out.add(v);
      findVersionIds(v, out);
    }
  }
  return [...out];
}

function findD1Uuid(value) {
  if (Array.isArray(value)) {
    for (const x of value) { const hit = findD1Uuid(x); if (hit) return hit; }
    return null;
  }
  if (!value || typeof value !== 'object') return null;
  const marker = value.binding ?? value.name;
  const type = String(value.type ?? value.kind ?? '').toLowerCase();
  if (marker === D1_BINDING || (marker === D1_NAME && type.includes('d1'))) {
    for (const key of ['database_id','databaseId','id','uuid','namespace_id']) {
      const v = value[key];
      if (typeof v === 'string' && /^[0-9a-f-]{36}$/i.test(v)) return v;
    }
  }
  for (const v of Object.values(value)) { const hit = findD1Uuid(v); if (hit) return hit; }
  return null;
}

function resolveD1Uuid() {
  const deployments = runWrangler(['deployments','status','--name',PROD_WORKER,'--json'], {capture:true, allowFailure:true});
  if (deployments.status === 0) {
    try {
      const status = parseJsonOutput(deployments.stdout);
      for (const versionId of findVersionIds(status)) {
        const view = runWrangler(['versions','view',versionId,'--name',PROD_WORKER,'--json'], {capture:true, allowFailure:true});
        if (view.status !== 0) continue;
        try { const hit = findD1Uuid(parseJsonOutput(view.stdout)); if (hit) return hit; } catch {}
      }
    } catch {}
  }
  const list = runWrangler(['d1','list','--json'], {capture:true, allowFailure:true});
  if (list.status === 0) {
    try {
      const data = parseJsonOutput(list.stdout);
      const rows = Array.isArray(data) ? data : (data.result || []);
      const db = rows.find((x) => x && x.name === D1_NAME);
      const id = db && (db.uuid || db.database_id || db.id);
      if (typeof id === 'string' && /^[0-9a-f-]{36}$/i.test(id)) return id;
    } catch {}
  }
  throw new Error(`Unable to resolve existing D1 database '${D1_NAME}'. Refusing to deploy without ${D1_BINDING}.`);
}

function writeRuntimeConfig(d1Uuid) {
  const templatePath = path.join('ci','wrangler.production.template.json');
  const runtimePath = path.join('ci','wrangler.runtime.json');
  const template = fs.readFileSync(templatePath,'utf8');
  if (!template.includes('__BOARDVERSE_D1_UUID__')) throw new Error('Production Wrangler template placeholder missing');
  fs.writeFileSync(runtimePath, template.replace('__BOARDVERSE_D1_UUID__', d1Uuid));
  return runtimePath;
}

try {
  if (!isWorkersCI) {
    const result = runWrangler(process.argv.slice(2));
    process.exit(result.status ?? 1);
  }

  if (branch !== 'main') {
    console.log(`[BoardVerse CI] Adapter active for preview branch '${branch || 'unknown'}'.`);
    const msg = `BoardVerse preview ${process.env.WORKERS_CI_COMMIT_SHA || 'unknown'}`;
    const result = runWrangler(['versions','upload','--config','ci/wrangler.preview.json','--keep-vars','--message',msg]);
    process.exit(result.status ?? 1);
  }

  const d1Uuid = resolveD1Uuid();
  console.log(`[BoardVerse CI] Existing ${D1_BINDING} resolved without persisting its UUID.`);
  const runtimeConfig = writeRuntimeConfig(d1Uuid);
  try {
    console.log(`[BoardVerse CI] Production branch detected; deploying ${PROD_WORKER}.`);
    const result = runWrangler(['deploy','--config',runtimeConfig,'--keep-vars']);
    process.exit(result.status ?? 1);
  } finally {
    try { fs.unlinkSync(runtimeConfig); } catch {}
  }
} catch (error) {
  console.error(`[BoardVerse CI] ${error?.message || error}`);
  process.exit(1);
}
